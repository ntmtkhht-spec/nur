rules_version = '2';

// Everything a signed-in user owns lives under /users/{uid}. Nothing else is
// readable or writable — with Firebase the client keys are public by design,
// so these rules are the only thing standing between a stranger and the data.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Prayer tracker entries, settings and anything added later.
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny by default: any path not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
