.claude/

# Firebase configuration.
# These carry project ids and client keys. Firebase treats them as public by
# design — they ship inside every built app, and the real protection is the
# Firestore security rules, not secrecy. They are kept out of this public
# repository anyway so the project is not trivially discoverable, and fed to
# CI from repository secrets instead. Regenerate locally with:
#   flutterfire configure --project=munir-9360e
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
firebase.json

# Android release signing. Losing this keystore before the first Play
# Console upload just means generating a new one; losing it after Play App
# Signing enrollment needs a Google support recovery request, so back the
# passwords and the .jks file up somewhere outside this repo.
android/key.properties
android/app/upload-keystore.jks

# Generated: the legal pages are rendered from lib/features/legal by
# tool/build_legal_site.dart and published by CI, never committed.
site/

# Downloaded release artifacts. The design-qa screenshots next to them are
# tracked on purpose; builds are not.
artifacts/ipa/
artifacts/aab/

# Kotlin incremental-compile scratch from Gradle.
android/.kotlin/
